{
  "tasks": {
    "dev": "deno run -A --node-modules-dir=auto npm:vite",
    "build": "deno run -A --node-modules-dir=auto npm:vite build"
  },
  "fmt": {
    "semiColons": false,
    "singleQuote": true
  },
  "nodeModulesDir": "auto",
  "imports": {
    "@ant-design/icons": "npm:@ant-design/icons@^6.0.1",
    "@ant-design/plots": "npm:@ant-design/plots@^2.6.4",
    "@deno/vite-plugin": "npm:@deno/vite-plugin@^1.0.5",
    "@psych/lib": "jsr:@psych/lib@^1.24.3",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.1.13",
    "@types/react": "npm:@types/react@^19.1.12",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@^4.7.0",
    "antd": "npm:antd@^5.27.3",
    "ml-pca": "npm:ml-pca@^4.1.1",
    "openai": "npm:openai@^5.20.0",
    "react": "npm:react@^19.1.1",
    "react-dom": "npm:react-dom@^19.1.1",
    "tailwindcss": "npm:tailwindcss@^4.1.13",
    "vite": "npm:vite@^6.3.6",
    "vite-plugin-singlefile": "npm:vite-plugin-singlefile@^2.3.0"
  },
  "compilerOptions": {
    "types": [
      "react",
      "react-dom",
      "@types/react"
    ],
    "lib": [
      "dom",
      "dom.iterable",
      "deno.ns"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}
